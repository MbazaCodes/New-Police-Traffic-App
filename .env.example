# ===== TZ Police Digital Platform — Environment Variables =====
# Copy this file to .env and fill in your values.

# ===== Database (Local PostgreSQL on VPS) =====
DATABASE_URL=postgresql://user:password@your-vps-host:5432/police_db
# Set DB_SSL=false for local dev without SSL
DB_SSL=false

# ===== NextAuth =====
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# ===== JWT =====
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ===== App =====
NEXT_PUBLIC_APP_NAME=TZ Police Digital Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Feature Flags =====
DEMO_MODE=false
OTP_BYPASS=true
NEXT_PUBLIC_OTP_BYPASS=true
NEXT_PUBLIC_SIMULATION=false
NEXT_PUBLIC_OFFLINE=false
NEXT_PUBLIC_SYNC=true

# ===== Audit Log =====
AUDIT_LOG_ENABLED=true
